# Copy to .env and fill in. .env is gitignored.

# AWS CLI profile the CDK CLI uses for credentials.
AWS_PROFILE=your-profile-name

# Account and region the stack deploys to. The existing toll-free number and
# shout-replies SNS topic live here, so keep these values. Deploys fail if
# AWS_PROFILE's credentials belong to a different account.
CDK_ACCOUNT=445044180652
CDK_REGION=us-west-1
